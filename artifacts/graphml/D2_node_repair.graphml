<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d0" for="node" attr.name="label" attr.type="string"/>
  <key id="d1" for="node" attr.name="shape" attr.type="string"/>
  <key id="d2" for="edge" attr.name="label" attr.type="string"/>
  <key id="d3" for="edge" attr.name="guard" attr.type="string"/>
  <key id="d4" for="edge" attr.name="action" attr.type="string"/>
  <key id="d5" for="graph" attr.name="machine_name" attr.type="string"/>
  <key id="d6" for="graph" attr.name="target_object" attr.type="string"/>
  <key id="d7" for="graph" attr.name="variables" attr.type="string"/>
  <graph id="D2" edgedefault="directed">
    <data key="d5">Узел_ремонт</data>
    <data key="d6">oxygen_pump, green_press, gas_station</data>
    <data key="d7">RepairedCount:int=0 (общая)</data>
    <node id="Idle">
      <data key="d0">Idle: узел аварийный, fire активен, красная индикация</data>
      <data key="d1">state</data>
    </node>
    <node id="Repaired">
      <data key="d0">Repaired: fire скрыт, зелёная индикация, текст «Узел восстановлен»</data>
      <data key="d1">state</data>
    </node>
    <edge id="e1" source="Idle" target="Repaired">
      <data key="d2">Игрок рядом + действие ремонта</data>
      <data key="d3">inZone(player) == true</data>
      <data key="d4">hide(fire); setGreenLight(); showText("Узел восстановлен"); RepairedCount := RepairedCount + 1; emit("УзелПочинен")</data>
    </edge>
  </graph>
</graphml>
